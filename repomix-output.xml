      </p>
      
      {/* Tabs de navegação */}
      <div className="flex flex-wrap gap-2 mb-6 border-b border-gray-200 dark:border-gray-700">
        <button
          onClick={() => setTabAtiva('conversor')}
          className={`px-4 py-2 rounded-t-lg font-medium transition-colors ${
